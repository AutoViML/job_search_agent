# =============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
#   cp .env.example .env
# =============================================================================

# ── API Keys ──────────────────────────────────────────────────
# Google Gemini: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=your-gemini-api-key-here

# Adzuna: https://developer.adzuna.com/ → Register → Dashboard → My Apps → Create App
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# ── Run Mode ──────────────────────────────────────────────────
# Start with TEST_RUN=True for a quick 5-job sanity check
# Set to False when you're ready for a full search
TEST_RUN=True
TEST_LIMIT=5

# ── Adzuna Limits ─────────────────────────────────────────────
# Adzuna hard-caps results_per_page at 50 — don't go above that
ADZUNA_LIMIT_PER_SEARCH=50
ADZUNA_MONTHLY_CALLS_LIMIT=250

# ── Search Parameters ─────────────────────────────────────────
# These can be auto-generated by running: uv run python init_search.py
# Or fill them in manually below.

# Comma-separated role search queries (one Adzuna search per entry per location)
SEARCH_QUERIES=entry level engineer,new graduate engineer,product design engineer,packaging engineer

# Comma-separated cities/metros to search
SEARCH_LOCATIONS=New York,New Jersey,Dallas,Austin,San Jose

# Search radius from each location center (~40 km ≈ 25 miles)
DISTANCE_KM=40

# ── Gemini LLM Settings ───────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash-lite
# Jobs reviewed per Gemini batch — keep at 20 to avoid token limits
LLM_CHUNK_SIZE=20
